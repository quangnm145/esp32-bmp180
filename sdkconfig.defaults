# Default flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Custom partition table: factory app 2 MB
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS tick 1 ms (pdMS_TO_TICKS chinh xac cho delay ngan)
CONFIG_FREERTOS_HZ=1000

# Web server: header Authorization/Cookie dai
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# BMP180 defaults
CONFIG_BMP180_SDA_GPIO=25
CONFIG_BMP180_SCL_GPIO=26
CONFIG_BMP180_SEA_LEVEL_PRESSURE_PA=101325

# Test mode without sensors (set to n when BMP180/DHT11 are wired)
CONFIG_APP_SENSOR_FAKE_DATA=y
