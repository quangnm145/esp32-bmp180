menu "BMP180 Configuration"

    config BMP180_SDA_GPIO
        int "I2C SDA GPIO"
        range 0 39
        default 25
        help
            GPIO connected to the BMP180 SDA pin.

    config BMP180_SCL_GPIO
        int "I2C SCL GPIO"
        range 0 39
        default 26
        help
            GPIO connected to the BMP180 SCL pin.

    config BMP180_SEA_LEVEL_PRESSURE_PA
        int "Sea-level reference pressure (Pa)"
        range 30000 120000
        default 101325
        help
            Reference pressure used to calculate altitude.

    config BMP180_UPDATE_INTERVAL_MS
        int "Measurement interval (ms)"
        range 100 60000
        default 5000
        help
            Delay between consecutive sensor readings.

endmenu

menu "ThingSpeak Configuration"
    config THINGSPEAK_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config THINGSPEAK_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config DHT11_GPIO
        int "DHT11 data GPIO"
        range 0 33
        default 27
        help
            Use an output-capable GPIO different from the BMP180 I2C pins.
endmenu
