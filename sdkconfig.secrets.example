# Copy to sdkconfig.secrets (git-ignored) and fill in real values,
# then: rm -f sdkconfig && idf.py build
CONFIG_APP_DEFAULT_TS_ENABLED=y
CONFIG_APP_DEFAULT_TS_CHANNEL_ID=123456
CONFIG_APP_DEFAULT_TS_WRITE_KEY="XXXXXXXXXXXXXXXX"
CONFIG_APP_DEFAULT_WIFI_SSID="MyWifi"
CONFIG_APP_DEFAULT_WIFI_PASSWORD="password"
